# systemd unit for `mysh serve` in connect-back mode: the server opens the
# connection to a client that accepts connections (`mysh accept`) instead
# of listening — for hosts without inbound reachability.
#
#   install -m 755 mysh /usr/local/bin/mysh
#   install -m 644 contrib/mysh-connect-back.service /etc/systemd/system/mysh-connect-back.service
#   systemctl edit mysh-connect-back     # set CONNECT_BACK to the accepting client
#   systemctl daemon-reload && systemctl enable --now mysh-connect-back
#
# The server serves the user it runs as (here: a dedicated `mysh` account;
# use `User=root` for a root shell). The host key is generated on first start
# under the state directory; authorize the accepting client's key in
# /var/lib/mysh/.config/mysh/authorized_keys or pass --authorized-key. The
# accepting client must list this server's key in its `callers` file.
#
# Nothing is bound: add `--listen [::]:7722` to serve dialing clients as
# well, or `--allow-bind-request` to let the accepting client ask for a
# listener on demand (`mysh @NAME bind 0.0.0.0:7722 --for 1h`).

[Unit]
Description=mysh remote shell server (connect-back)
Documentation=https://github.com/devx00/mysh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mysh
Group=mysh
DynamicUser=yes
StateDirectory=mysh
Environment=HOME=/var/lib/mysh
Environment=MYSH_CONFIG_DIR=/var/lib/mysh/.config/mysh
# host[:port] of the accepting client; repeat --connect-back for several.
Environment=CONNECT_BACK=client.example.org:7722
ExecStart=/usr/local/bin/mysh serve --connect-back ${CONNECT_BACK} --connect-period 5m --connect-jitter 10 --connect-max 30m
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# Sessions need a pty and a working /dev/pts; everything else is locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mysh /tmp
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
